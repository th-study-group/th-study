{
    "openapi": "3.0.0",
    "info": {
        "title": "티에이치스터디 API",
        "description": "티에이치스터디 API 문서",
        "contact": {
            "name": "티에이치스터디",
            "email": "admin@th-study.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "현재 서버"
        },
        {
            "url": "http://localhost:8000",
            "description": "로컬 서버"
        },
        {
            "url": "http://localhost:8080",
            "description": "도커 서버"
        },
        {
            "url": "https://www.th-study.com",
            "description": "운영 서버"
        }
    ],
    "paths": {
        "/api/swagger-test": {
            "get": {
                "tags": [
                    "테스트"
                ],
                "summary": "Swagger 테스트",
                "description": "Swagger가 정상적으로 동작하는지 확인하는 테스트 API",
                "operationId": "98b4d044495b00e561e1f9922dc4e2e2",
                "responses": {
                    "200": {
                        "description": "정상 응답",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Swagger test success"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/mcp/tools/note-groups": {
            "post": {
                "tags": [
                    "MCP"
                ],
                "summary": "그룹 조회",
                "description": "노트의 최상위 분류인 그룹 목록을 조회합니다. 그룹 코드 또는 그룹명을 조건으로 검색할 수 있습니다.",
                "operationId": "eecb00c16053b3b4c04bbdfcea94d031",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "group_code": {
                                        "description": "그룹 코드 정확히 일치 검색",
                                        "type": "string",
                                        "example": "blog",
                                        "nullable": true,
                                        "maxLength": 20
                                    },
                                    "group_name": {
                                        "description": "그룹명 포함 검색",
                                        "type": "string",
                                        "example": "블로그",
                                        "nullable": true,
                                        "maxLength": 30
                                    },
                                    "page": {
                                        "description": "조회 페이지 번호",
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true,
                                        "default": 1,
                                        "minimum": 1
                                    },
                                    "per_page": {
                                        "description": "페이지당 조회 개수",
                                        "type": "integer",
                                        "example": 20,
                                        "nullable": true,
                                        "default": 20,
                                        "maximum": 100,
                                        "minimum": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "그룹 조회 성공",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "노트 그룹 목록 조회 성공"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "group_code": {
                                                        "description": "그룹 코드",
                                                        "type": "string",
                                                        "example": "blog"
                                                    },
                                                    "group_name": {
                                                        "description": "그룹명",
                                                        "type": "string",
                                                        "example": "블로그"
                                                    },
                                                    "create_datetime": {
                                                        "description": "등록일시",
                                                        "type": "string",
                                                        "example": "2026-07-26 15:00:00"
                                                    },
                                                    "create_user_idx": {
                                                        "description": "등록자 사용자 IDX",
                                                        "type": "integer",
                                                        "example": 1
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        },
                                        "pagination": {
                                            "properties": {
                                                "current_page": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "per_page": {
                                                    "type": "integer",
                                                    "example": 20
                                                },
                                                "total": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "last_page": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "has_more": {
                                                    "type": "boolean",
                                                    "example": false
                                                },
                                                "next_page": {
                                                    "type": "integer",
                                                    "example": null,
                                                    "nullable": true
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "인증 실패",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthenticated."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "유효성 검사 실패",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "유효성 검사 실패"
                                        },
                                        "errors": {
                                            "type": "object",
                                            "example": {
                                                "group_code": [
                                                    "그룹 코드는 20자를 초과할 수 없습니다."
                                                ],
                                                "per_page": [
                                                    "페이지당 조회 개수는 100 이하이어야 합니다."
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "테스트"
        },
        {
            "name": "MCP"
        }
    ]
}